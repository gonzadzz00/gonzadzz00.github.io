---
/**
 * Hero cover artwork: an "AI chip" with circuit traces radiating from it, drawn as inline SVG
 * so it stays crisp at any size and weighs nothing. Traces are generated at build time from a
 * seeded PRNG, so the composition is deterministic.
 */

const VIEW_W = 1600;
const VIEW_H = 900;
const CHIP = { x: 1180, y: 450, half: 85 };
const UNIT = 34;
const PIN_OFFSETS = [-51, -17, 17, 51];
const PIN_LENGTH = 14;

function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Point = [number, number];
interface Trace {
  d: string;
  end: Point;
  pulse: boolean;
  delay: number;
  duration: number;
}
interface Pin {
  a: Point;
  b: Point;
}

const rand = mulberry32(11);
const sides: Array<{ out: Point; pin: (offset: number) => Point }> = [
  { out: [1, 0], pin: o => [CHIP.x + CHIP.half, CHIP.y + o] },
  { out: [-1, 0], pin: o => [CHIP.x - CHIP.half, CHIP.y + o] },
  { out: [0, 1], pin: o => [CHIP.x + o, CHIP.y + CHIP.half] },
  { out: [0, -1], pin: o => [CHIP.x + o, CHIP.y - CHIP.half] },
];

// Keep endpoints clear of the fixed navbar at the top
const inBounds = ([x, y]: Point) => x > 24 && x < VIEW_W - 24 && y > 110 && y < VIEW_H - 24;

const traces: Trace[] = [];
const pins: Pin[] = [];

sides.forEach(side => {
  PIN_OFFSETS.forEach(offset => {
    const [ox, oy] = side.out;
    const base = side.pin(offset);
    const start: Point = [base[0] + ox * PIN_LENGTH, base[1] + oy * PIN_LENGTH];
    pins.push({ a: base, b: start });

    // Lanes fan away from the middle of each side so traces never cross
    const sign = offset < 0 ? -1 : 1;
    const [px, py] = ox === 0 ? [sign, 0] : [0, sign];

    const points: Point[] = [start];
    let [x, y] = start;
    const segments = 2 + Math.floor(rand() * 2);

    for (let s = 0; s < segments; s++) {
      const run = 2 + Math.floor(rand() * 4);
      x += ox * UNIT * run;
      y += oy * UNIT * run;
      points.push([x, y]);

      if (rand() < 0.9) {
        const jog = 1 + Math.floor(rand() * 2);
        x += (ox + px) * UNIT * jog;
        y += (oy + py) * UNIT * jog;
        points.push([x, y]);
      }
    }

    const kept: Point[] = [];
    for (const point of points) {
      if (!inBounds(point)) break;
      kept.push(point);
    }
    if (kept.length < 2) return;

    traces.push({
      d: kept.map(([px2, py2], i) => `${i === 0 ? 'M' : 'L'}${px2} ${py2}`).join(' '),
      end: kept[kept.length - 1],
      pulse: rand() < 0.6,
      delay: rand() * -8,
      duration: 5 + rand() * 4,
    });
  });
});

const chipLeft = CHIP.x - CHIP.half;
const chipTop = CHIP.y - CHIP.half;
const chipSize = CHIP.half * 2;

// CPU die inside the package: 2x2 cores around a shared cache strip
const DIE_INSET = 26;
const dieX = chipLeft + DIE_INSET;
const dieY = chipTop + DIE_INSET;
const dieSize = chipSize - DIE_INSET * 2;
const DIE_PAD = 8;
const CORE_GAP = 6;
const CORE_W = (dieSize - DIE_PAD * 2 - CORE_GAP) / 2;
const CORE_H = 34;
const CACHE_H = dieSize - DIE_PAD * 2 - CORE_H * 2 - CORE_GAP * 2;
const cores = [0, 1].flatMap(row =>
  [0, 1].map(col => ({
    x: dieX + DIE_PAD + col * (CORE_W + CORE_GAP),
    y: dieY + DIE_PAD + row * (CORE_H + CACHE_H + CORE_GAP * 2),
    delay: (row * 2 + col) * -1,
  }))
);
const cacheY = dieY + DIE_PAD + CORE_H + CORE_GAP;
---

<div class="hero-art" aria-hidden="true">
  <div class="hero-orb hero-orb--cyan"></div>
  <div class="hero-orb hero-orb--purple"></div>

  <svg class="hero-art-svg" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="xMaxYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="chip-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#00a4ef" stop-opacity="0.45" />
        <stop offset="55%" stop-color="#00a4ef" stop-opacity="0.10" />
        <stop offset="100%" stop-color="#00a4ef" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="chip-stroke" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#3de0e0" />
        <stop offset="55%" stop-color="#00a4ef" />
        <stop offset="100%" stop-color="#7b2ff7" />
      </linearGradient>
      <linearGradient id="core-fill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#00a4ef" />
        <stop offset="100%" stop-color="#7b2ff7" />
      </linearGradient>
      <linearGradient id="die-fill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#0b2e4c" />
        <stop offset="100%" stop-color="#040f24" />
      </linearGradient>
      <!-- transistor-array texture for the cores -->
      <pattern id="cpu-cells" width="5" height="5" patternUnits="userSpaceOnUse">
        <rect x="1" y="1" width="2.6" height="2.6" rx="0.5" fill="#8ff5f5" fill-opacity="0.32" />
      </pattern>
      <!-- cache rows -->
      <pattern id="cpu-cache" width="4" height="4" patternUnits="userSpaceOnUse">
        <path d="M0 3.5H4" stroke="#3de0e0" stroke-opacity="0.45" stroke-width="0.8" />
      </pattern>
    </defs>

    <circle cx={CHIP.x} cy={CHIP.y} r="330" fill="url(#chip-halo)" />

    <g class="traces">
      {traces.map(t => (
        <path class="trace" d={t.d} pathLength="100" />
      ))}
    </g>

    <g class="pulses">
      {traces.filter(t => t.pulse).map(t => (
        <path
          class="pulse"
          d={t.d}
          pathLength="100"
          style={`animation-delay: ${t.delay.toFixed(2)}s; animation-duration: ${t.duration.toFixed(2)}s`}
        />
      ))}
    </g>

    <g class="nodes">
      {traces.map(t => (
        <>
          <circle class="node-ring" cx={t.end[0]} cy={t.end[1]} r="6" />
          <circle class="node-dot" cx={t.end[0]} cy={t.end[1]} r="2.4" />
        </>
      ))}
    </g>

    <g class="chip">
      {pins.map(p => (
        <line class="pin" x1={p.a[0]} y1={p.a[1]} x2={p.b[0]} y2={p.b[1]} />
      ))}
      <rect class="chip-body" x={chipLeft} y={chipTop} width={chipSize} height={chipSize} rx="22" />
      <rect class="chip-inner" x={dieX - 6} y={dieY - 6} width={dieSize + 12} height={dieSize + 12} rx="14" />
      <polygon class="cpu-notch" points={`${chipLeft + 9},${chipTop + 9} ${chipLeft + 22},${chipTop + 9} ${chipLeft + 9},${chipTop + 22}`} />
      <rect class="cpu-die" x={dieX} y={dieY} width={dieSize} height={dieSize} rx="8" fill="url(#die-fill)" />
      {cores.map(c => (
        <g class="cpu-core">
          <rect class="cpu-core-base" x={c.x} y={c.y} width={CORE_W} height={CORE_H} rx="4" fill="url(#core-fill)" />
          <rect x={c.x} y={c.y} width={CORE_W} height={CORE_H} rx="4" fill="url(#cpu-cells)" />
          <rect class="cpu-core-glow" x={c.x} y={c.y} width={CORE_W} height={CORE_H} rx="4" style={`animation-delay: ${c.delay}s`} />
        </g>
      ))}
      <rect class="cpu-cache" x={dieX + DIE_PAD} y={cacheY} width={dieSize - DIE_PAD * 2} height={CACHE_H} rx="3" />
      <rect x={dieX + DIE_PAD} y={cacheY} width={dieSize - DIE_PAD * 2} height={CACHE_H} rx="3" fill="url(#cpu-cache)" />
    </g>
  </svg>
</div>

<style is:global>
  .hero-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Keep the left side calm so the title stays readable */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.55) 30%, #000 55%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.55) 30%, #000 55%);
  }

  .hero-art-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-art .trace {
    fill: none;
    stroke: rgba(61, 224, 224, 0.38);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .hero-art .pulse {
    fill: none;
    stroke: #8ff5f5;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 9 91;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 5px rgba(61, 224, 224, 0.9));
    animation: hero-pulse 7s linear infinite;
  }

  .hero-art .node-ring {
    fill: #061b36;
    stroke: #3de0e0;
    stroke-width: 1.6;
  }

  .hero-art .node-dot {
    fill: #8ff5f5;
  }

  .hero-art .pin {
    stroke: #3de0e0;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .hero-art .chip-body {
    fill: #061b36;
    stroke: url(#chip-stroke);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 18px rgba(0, 164, 239, 0.55));
  }

  .hero-art .chip-inner {
    fill: rgba(0, 164, 239, 0.08);
    stroke: rgba(61, 224, 224, 0.55);
    stroke-width: 1.2;
  }

  .hero-art .cpu-notch {
    fill: #3de0e0;
    opacity: 0.9;
  }

  .hero-art .cpu-die {
    stroke: rgba(61, 224, 224, 0.75);
    stroke-width: 1.2;
  }

  .hero-art .cpu-core-base {
    fill-opacity: 0.75;
    stroke: rgba(143, 245, 245, 0.7);
    stroke-width: 0.9;
  }

  /* Cores take turns lighting up, like load moving across the die */
  .hero-art .cpu-core-glow {
    fill: #3de0e0;
    opacity: 0;
    animation: hero-core-load 4s ease-in-out infinite;
  }

  .hero-art .cpu-cache {
    fill: rgba(0, 164, 239, 0.1);
    stroke: rgba(61, 224, 224, 0.6);
    stroke-width: 0.9;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
  }

  .hero-orb--cyan {
    width: 46vw;
    height: 46vw;
    max-width: 760px;
    max-height: 760px;
    right: 2%;
    top: 12%;
    background: radial-gradient(circle, rgba(0, 164, 239, 0.32), transparent 65%);
    animation: hero-drift 18s ease-in-out infinite alternate;
  }

  .hero-orb--purple {
    width: 28vw;
    height: 28vw;
    max-width: 460px;
    max-height: 460px;
    right: -4%;
    bottom: -8%;
    background: radial-gradient(circle, rgba(123, 47, 247, 0.30), transparent 65%);
    animation: hero-drift 22s ease-in-out infinite alternate-reverse;
  }

  @keyframes hero-pulse {
    to { stroke-dashoffset: -100; }
  }

  @keyframes hero-core-load {
    0%, 100% { opacity: 0; }
    30% { opacity: 0.5; }
  }

  @keyframes hero-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-3%, 4%, 0); }
  }

  /* Mobile: centre the chip below the title and let the art bleed off the sides */
  @media (max-width: 991px) {
    .hero-art {
      -webkit-mask-image: none;
      mask-image: none;
      opacity: 0.85;
    }

    .hero-art-svg {
      inset: auto;
      left: 50%;
      bottom: -2%;
      width: 230vw;
      height: auto;
      aspect-ratio: 16 / 9;
      transform: translateX(-73.75%);
    }

    .hero-orb--cyan {
      right: -10%;
      top: auto;
      bottom: 0;
      width: 90vw;
      height: 90vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art .pulse,
    .hero-art .cpu-core-glow,
    .hero-orb {
      animation: none;
    }
  }

  /* Paused off screen by Hero.astro */
  .hero.is-offscreen .hero-art .pulse,
  .hero.is-offscreen .hero-art .cpu-core-glow,
  .hero.is-offscreen .hero-orb {
    animation-play-state: paused;
  }
</style>
