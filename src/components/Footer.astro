---
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const rights = strings['footer.rights'];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-text">
      &copy; {year} Gonzalo Diaz.
      <span data-i18n-es={rights.es} data-i18n-en={rights.en}>{rights.es}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--header-bg);
    color: var(--link-color);
    padding: var(--space-xl) var(--space-lg);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

.footer-text {
    font-size: var(--text-sm);
    opacity: 0.7;
    margin: 0;
  }
</style>
