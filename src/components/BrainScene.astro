---
import techStack from '../data/tech-stack.json';
import uiStrings from '../data/ui-strings.json';

interface Props {
  modelSrc: string;
  posterSrc: string;
  floatingIcons: string[];
}

const { modelSrc, posterSrc, floatingIcons } = Astro.props;
const strings: Record<string, { es: string; en: string }> = uiStrings;
const alt = strings['about.modelAlt'];

const icons = floatingIcons
  .map(name => techStack.find((t: any) => t.name === name))
  .filter((t): t is (typeof techStack)[number] => Boolean(t));
---

<div
  class="brain-scene"
  data-brain-scene
  data-src={modelSrc}
  data-alt-es={alt.es}
  data-alt-en={alt.en}
>
  <div class="brain-scene-frame" aria-hidden="true">
    <img
      class="brain-scene-poster"
      src={posterSrc}
      alt=""
      width="1584"
      height="656"
      loading="lazy"
      decoding="async"
    />
    <div class="brain-scene-glow"></div>
  </div>
  <ul class="brain-floaters" aria-hidden="true">
    {icons.map((tech, i) => (
      <li class={`brain-floater brain-floater--${i + 1}`} style={`--float-delay: ${i * -1.3}s`}>
        <img src={tech.iconUrl} alt="" width="26" height="26" loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</div>

<script>
  import { mountModel } from './modelLoader';

  function initBrainScene() {
    document.querySelectorAll<HTMLElement>('[data-brain-scene]').forEach(el => {
      mountModel(el, { tint: [0.02, 0.5, 0.85], parallax: true });
    });
  }

  initBrainScene();
  document.addEventListener('astro:after-swap', initBrainScene);
</script>

<style is:global>
  .brain-scene {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  /* The poster is the static fallback; the 3D model fades in over it and replaces it */
  .brain-scene-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #061a2e;
    box-shadow: var(--card-shadow), var(--glow-shadow);
  }

  .brain-scene-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 50%;
    transition: opacity var(--motion-duration-slow) var(--motion-ease);
  }

  .brain-scene.is-ready .brain-scene-poster {
    opacity: 0;
  }

  .brain-scene-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(0, 164, 239, 0.32), transparent 65%);
    pointer-events: none;
  }

  .brain-scene .model-viewer-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    outline: none;
  }

  .brain-floaters {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .brain-floater {
    position: absolute;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 4px 18px rgba(0, 164, 239, 0.35);
  }

  .brain-floater img {
    width: 26px;
    height: 26px;
  }

  .brain-floater--1 { left: -5%; top: 12%; }
  .brain-floater--2 { right: 8%; top: -4%; }
  .brain-floater--3 { right: -5%; top: 46%; }
  .brain-floater--4 { right: 12%; bottom: -4%; }
  .brain-floater--5 { left: 10%; bottom: -5%; }
  .brain-floater--6 { left: -6%; top: 55%; }

  @media (prefers-reduced-motion: no-preference) {
    .brain-floater {
      animation: brain-float calc(var(--motion-duration-slow) * 5) ease-in-out infinite alternate;
      animation-delay: var(--float-delay, 0s);
    }
  }

  @keyframes brain-float {
    from { transform: translateY(0); }
    to { transform: translateY(-12px); }
  }

  @media (max-width: 480px) {
    .brain-floater--5,
    .brain-floater--6 {
      display: none;
    }
  }
</style>
