---
/**
 * The capabilities that come out of the chip: machine learning (neural network) and
 * computer vision. The SVGs animate with SMIL, which CSS cannot control,
 * so they are inlined (after the first paint, to keep them off the LCP path) and paused or
 * resumed from the script below.
 */
import neuralNetwork from '../assets/hero/neural-network.svg?raw';
import computerVision from '../assets/hero/computer-vision.svg?raw';

// Stagger so they never pulse together: neural network, computer vision
const illustrations = [
  { id: 'nn', svg: neuralNetwork, delay: 0 },
  { id: 'cv', svg: computerVision, delay: 1200 },
];
---

<div class="hero-decor" aria-hidden="true">
  {illustrations.map(i => (
    <div class={`ill ill--${i.id}`} data-ill={i.id} data-delay={i.delay}>
      <template><Fragment set:html={i.svg} /></template>
    </div>
  ))}
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const timers = new WeakMap<SVGSVGElement, number>();

  const slots = () => Array.from(document.querySelectorAll<HTMLElement>('.hero-decor .ill'));
  const svgOf = (slot: HTMLElement) => slot.querySelector<SVGSVGElement>('svg');
  const shown = (slot: HTMLElement) => getComputedStyle(slot).display !== 'none';

  function play(svg: SVGSVGElement, delay = 0) {
    window.clearTimeout(timers.get(svg));
    if (reducedMotion.matches || document.hidden) return;
    timers.set(svg, window.setTimeout(() => svg.unpauseAnimations(), delay));
  }

  function freeze(svg: SVGSVGElement) {
    window.clearTimeout(timers.get(svg));
    svg.pauseAnimations();
  }

  // One observer: pause when an illustration leaves the viewport, resume when it returns
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const svg = svgOf(entry.target as HTMLElement);
      if (!svg) return;
      if (entry.isIntersecting) play(svg);
      else freeze(svg);
    });
  });

  function mount(slot: HTMLElement) {
    const template = slot.querySelector('template');
    if (svgOf(slot) || !template || !shown(slot)) return;
    slot.append(template.content.cloneNode(true));
    const svg = svgOf(slot);
    if (!svg) return;

    // Start frozen; the stagger delay decides when each one begins
    svg.pauseAnimations();
    if (reducedMotion.matches) svg.setCurrentTime(2.5);
    else play(svg, Number(slot.dataset.delay ?? 0));
    observer.observe(slot);
  }

  function mountVisible() {
    slots().forEach(mount);
  }

  function applyMotionPreference() {
    slots().forEach(slot => {
      const svg = svgOf(slot);
      if (!svg) return;
      if (reducedMotion.matches) {
        freeze(svg);
        svg.setCurrentTime(2.5);
      } else {
        play(svg);
      }
    });
  }

  function init() {
    // After the first render, so the chip and the text own the LCP
    const start = () => mountVisible();
    if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1200 });
    else window.setTimeout(start, 200);

    // Illustrations hidden at the current width are only inserted once they become visible
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(mountVisible, 150);
    });

    reducedMotion.addEventListener('change', applyMotionPreference);
    document.addEventListener('visibilitychange', () => {
      slots().forEach(slot => {
        const svg = svgOf(slot);
        if (!svg) return;
        if (document.hidden) freeze(svg);
        else play(svg);
      });
    });
  }

  init();
</script>

<style is:global>
  .hero-decor {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .ill {
    position: absolute;
    display: none;
    opacity: 0.85;
    transform-origin: center;
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }

  .ill svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Desktop (>= 1280px), anchored to the viewport so the composition scales together */
  @media (min-width: 1280px) and (min-height: 500px) {
    .ill {
      display: block;
    }

    .ill--nn {
      right: 4vw;
      top: 13vh;
      width: 15vw;
    }

    .ill--cv {
      right: 2vw;
      bottom: 6vh;
      width: 17vw;
    }
  }

  /* Tablet: the neural network up top */
  @media (min-width: 768px) and (max-width: 1279px) and (min-height: 500px) {
    .ill--nn {
      display: block;
      right: 4vw;
      top: 11vh;
      width: 20vw;
    }
  }

  /* Hover / focus on a hero term: its illustration comes forward, the others step back */
  @media (min-width: 768px) {
    .hero[data-active] .ill {
      opacity: 0.45;
    }

    .hero[data-active='nn'] .ill--nn,
    .hero[data-active='cv'] .ill--cv {
      opacity: 1;
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero[data-active='nn'] .ill--nn,
    .hero[data-active='cv'] .ill--cv {
      transform: none;
    }
  }
</style>
