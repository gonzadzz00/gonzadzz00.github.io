---
/**
 * Extra hero details that nod to AI and automation: isometric illustrations of a neural
 * network, an AI workflow and computer vision.
 * Purely decorative (aria-hidden) and only shown on wide screens, where there is room.
 */
---

<div class="hero-decor" aria-hidden="true">
  <img class="decor-workflow" src="/images/hero/workflow-isometrico.svg" alt="" width="640" height="430" loading="lazy" decoding="async" />
  <img class="decor-vision" src="/images/hero/computer-vision-isometrico.svg" alt="" width="420" height="342" loading="lazy" decoding="async" />
  <img class="decor-nn-iso" src="/images/hero/red-neuronal-isometrica.svg" alt="" width="340" height="283" loading="lazy" decoding="async" />
</div>

<style is:global>
  .hero-decor {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    pointer-events: none;
  }

  @media (min-width: 1200px) {
    .hero-decor {
      display: block;
    }
  }

  /* ---- isometric neural network (top right) ---- */
  .decor-nn-iso {
    position: absolute;
    right: 3%;
    top: 13%;
    width: min(24vw, 40vh, 380px);
    height: auto;
    animation: decor-bob 10s ease-in-out infinite alternate;
    animation-delay: -3s;
  }

  /* ---- isometric computer vision (bottom right) ---- */
  .decor-vision {
    position: absolute;
    right: 2%;
    bottom: 0;
    width: min(30vw, 50vh, 440px);
    height: auto;
    animation: decor-bob 11s ease-in-out infinite alternate;
    animation-delay: -6s;
  }

  /* ---- isometric workflow (bottom left, below the title) ---- */
  .decor-workflow {
    position: absolute;
    left: 4%;
    bottom: 0;
    width: min(46vw, 74vh, 760px);
    height: auto;
    animation: decor-bob 9s ease-in-out infinite alternate;
  }

  /* Short laptop screens: smaller illustrations so they stay clear of the title */
  @media (min-width: 1200px) and (max-height: 760px) {
    .decor-workflow {
      width: min(40vw, 58vh);
      left: 5%;
      bottom: 0;
    }
  }

  @keyframes decor-bob {
    from { transform: translateY(0); }
    to { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .decor-nn-iso,
    .decor-vision,
    .decor-workflow {
      animation: none;
    }
  }

  /* Paused off screen by Hero.astro */
  .hero.is-offscreen .decor-nn-iso,
  .hero.is-offscreen .decor-vision,
  .hero.is-offscreen .decor-workflow {
    animation-play-state: paused;
  }
</style>
