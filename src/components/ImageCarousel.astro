---
interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="carousel" data-carousel>
    <div class="carousel-track">
      {images.map((img: { src: string; alt: string }, i: number) => (
        <div class={`carousel-slide ${i === 0 ? 'active' : ''}`}>
          <img src={img.src} alt={img.alt} loading="lazy" data-lightbox-open />
        </div>
      ))}
    </div>

    {images.length > 1 && (
      <>
        <button
          class="carousel-btn prev"
          data-carousel-prev
          data-i18n-attr="aria-label"
          data-i18n-attr-es="Imagen anterior"
          data-i18n-attr-en="Previous image"
          aria-label="Imagen anterior"
        >
          &#10094;
        </button>
        <button
          class="carousel-btn next"
          data-carousel-next
          data-i18n-attr="aria-label"
          data-i18n-attr-es="Imagen siguiente"
          data-i18n-attr-en="Next image"
          aria-label="Imagen siguiente"
        >
          &#10095;
        </button>
        <div class="carousel-dots">
          {images.map((_: any, i: number) => (
            <button
              class={`carousel-dot ${i === 0 ? 'active' : ''}`}
              data-carousel-dot={i}
              data-i18n-attr="aria-label"
              data-i18n-attr-es={`Ir a imagen ${i + 1}`}
              data-i18n-attr-en={`Go to image ${i + 1}`}
              aria-label={`Ir a imagen ${i + 1}`}
            />
          ))}
        </div>
      </>
    )}
  </div>

  <div class="lightbox-overlay" data-lightbox tabindex="-1">
    <button
      class="lightbox-close"
      data-lightbox-close
      data-i18n-attr="aria-label"
      data-i18n-attr-es="Cerrar vista previa"
      data-i18n-attr-en="Close preview"
      aria-label="Cerrar vista previa"
    >
      <i class="fas fa-times"></i>
    </button>

    {images.length > 1 && (
      <>
        <button
          class="lightbox-btn prev"
          data-lightbox-prev
          data-i18n-attr="aria-label"
          data-i18n-attr-es="Imagen anterior"
          data-i18n-attr-en="Previous image"
          aria-label="Imagen anterior"
        >
          &#10094;
        </button>
        <button
          class="lightbox-btn next"
          data-lightbox-next
          data-i18n-attr="aria-label"
          data-i18n-attr-es="Imagen siguiente"
          data-i18n-attr-en="Next image"
          aria-label="Imagen siguiente"
        >
          &#10095;
        </button>
      </>
    )}

    <img class="lightbox-img" data-lightbox-img src="" alt="" />
  </div>
)}

<script>
  function initCarousels() {
    document.querySelectorAll('[data-carousel]').forEach(carousel => {
      const wrapper = carousel.parentElement;
      const slides = carousel.querySelectorAll('.carousel-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const prevBtn = carousel.querySelector('[data-carousel-prev]');
      const nextBtn = carousel.querySelector('[data-carousel-next]');
      const lightbox = wrapper?.querySelector<HTMLElement>('[data-lightbox]');
      const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const lightboxCloseBtn = lightbox?.querySelector('[data-lightbox-close]');
      const lightboxPrevBtn = lightbox?.querySelector('[data-lightbox-prev]');
      const lightboxNextBtn = lightbox?.querySelector('[data-lightbox-next]');
      let current = 0;
      let startX = 0;

      function syncLightbox() {
        if (!lightboxImg) return;
        const activeImg = slides[current]?.querySelector('img');
        if (activeImg) {
          lightboxImg.src = activeImg.src;
          lightboxImg.alt = activeImg.alt;
        }
      }

      function goTo(index: number) {
        slides[current]?.classList.remove('active');
        dots[current]?.classList.remove('active');
        current = (index + slides.length) % slides.length;
        slides[current]?.classList.add('active');
        dots[current]?.classList.add('active');
        syncLightbox();
      }

      function openLightbox() {
        if (!lightbox) return;
        // Move to <body> so `position: fixed` covers the full viewport
        // instead of being contained by an ancestor modal's transform.
        if (lightbox.parentElement !== document.body) {
          document.body.appendChild(lightbox);
        }
        syncLightbox();
        lightbox.classList.add('active');
        lightbox.focus();
      }

      function closeLightbox() {
        lightbox?.classList.remove('active');
      }

      prevBtn?.addEventListener('click', () => goTo(current - 1));
      nextBtn?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

      slides.forEach(slide => {
        slide.querySelector('[data-lightbox-open]')?.addEventListener('click', openLightbox);
      });

      lightboxCloseBtn?.addEventListener('click', closeLightbox);
      lightboxPrevBtn?.addEventListener('click', () => goTo(current - 1));
      lightboxNextBtn?.addEventListener('click', () => goTo(current + 1));

      lightbox?.addEventListener('click', (e: Event) => {
        if (e.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener('keydown', (e: Event) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Escape') closeLightbox();
        if (key === 'ArrowLeft') goTo(current - 1);
        if (key === 'ArrowRight') goTo(current + 1);
      });

      // Touch swipe support
      carousel.addEventListener('touchstart', (e: Event) => {
        startX = (e as TouchEvent).touches[0].clientX;
      }, { passive: true });

      carousel.addEventListener('touchend', (e: Event) => {
        const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          goTo(diff > 0 ? current + 1 : current - 1);
        }
      }, { passive: true });

      lightbox?.addEventListener('touchstart', (e: Event) => {
        startX = (e as TouchEvent).touches[0].clientX;
      }, { passive: true });

      lightbox?.addEventListener('touchend', (e: Event) => {
        const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          goTo(diff > 0 ? current + 1 : current - 1);
        }
      }, { passive: true });

      // Keyboard support
      carousel.setAttribute('tabindex', '0');
      carousel.addEventListener('keydown', (e: Event) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'ArrowLeft') goTo(current - 1);
        if (key === 'ArrowRight') goTo(current + 1);
      });
    });
  }

  function initGlobalLightboxEscape() {
    // Capture phase + stopPropagation so this always resolves before the
    // project-modal's own Escape handler, regardless of script load order.
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      const activeLightboxes = document.querySelectorAll<HTMLElement>('[data-lightbox].active');
      if (activeLightboxes.length === 0) return;
      activeLightboxes.forEach(lb => lb.classList.remove('active'));
      e.stopPropagation();
    }, true);
  }

  initCarousels();
  initGlobalLightboxEscape();
  document.addEventListener('astro:after-swap', initCarousels);
</script>

<style>
  .carousel {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-color);
    border: 1px solid var(--border-color);
  }

  .carousel-track {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    z-index: 2;
  }

  .carousel-btn:hover {
    background: rgba(0, 0, 0, 0.6);
  }

  .carousel-btn.prev { left: 8px; }
  .carousel-btn.next { right: 8px; }

  .carousel-dots {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 0;
    transition: background var(--transition-fast);
  }

  .carousel-dot.active {
    background: #fff;
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 1150;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl, 24px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
    outline: none;
  }

  .lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    cursor: default;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    z-index: 2;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .lightbox-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    z-index: 2;
  }

  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .lightbox-btn.prev { left: 16px; }
  .lightbox-btn.next { right: 16px; }

  @media (max-width: 600px) {
    .lightbox-overlay {
      padding: 12px;
    }

    .lightbox-close {
      top: 8px;
      right: 8px;
    }

    .lightbox-btn.prev { left: 8px; }
    .lightbox-btn.next { right: 8px; }
  }
</style>
