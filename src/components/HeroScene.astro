---
import techStack from '../data/tech-stack.json';
import uiStrings from '../data/ui-strings.json';

interface Props {
  modelSrc: string;
  floatingIcons: string[];
}

const { modelSrc, floatingIcons } = Astro.props;
const strings: Record<string, { es: string; en: string }> = uiStrings;
const alt = strings['hero.modelAlt'];

const icons = floatingIcons
  .map(name => techStack.find((t: any) => t.name === name))
  .filter((t): t is (typeof techStack)[number] => Boolean(t));
---

<div
  class="hero-scene"
  data-hero-scene
  data-src={modelSrc}
  data-alt-es={alt.es}
  data-alt-en={alt.en}
>
  <div class="hero-scene-glow" aria-hidden="true"></div>
  <ul class="hero-floaters" aria-hidden="true">
    {icons.map((tech, i) => (
      <li class={`hero-floater hero-floater--${i + 1}`} style={`--float-delay: ${i * -1.3}s`}>
        <img src={tech.iconUrl} alt="" width="26" height="26" loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</div>

<script>
  import { mountModel } from './modelLoader';

  function initHeroScene() {
    document.querySelectorAll<HTMLElement>('[data-hero-scene]').forEach(el => {
      mountModel(el, { tint: [0.02, 0.5, 0.85], parallax: true });
    });
  }

  initHeroScene();
  document.addEventListener('astro:after-swap', initHeroScene);
</script>

<style is:global>
  .hero-scene {
    position: absolute;
    right: 10%;
    top: 50%;
    z-index: 1;
    width: clamp(240px, 30vw, 440px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-duration-slow) var(--motion-ease);
  }

  .hero-scene.is-ready {
    opacity: 1;
    visibility: visible;
  }

  .hero-scene .model-viewer-el {
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    outline: none;
  }

  .hero-scene-glow {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 164, 239, 0.28), transparent 68%);
    filter: blur(24px);
    pointer-events: none;
  }

  .hero-floaters {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .hero-floater {
    position: absolute;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 4px 18px rgba(0, 164, 239, 0.35);
  }

  .hero-floater img {
    width: 26px;
    height: 26px;
  }

  .hero-floater--1 { left: -4%; top: 14%; }
  .hero-floater--2 { right: 2%; top: 4%; }
  .hero-floater--3 { right: -4%; top: 46%; }
  .hero-floater--4 { right: 6%; bottom: 8%; }
  .hero-floater--5 { left: 4%; bottom: 4%; }
  .hero-floater--6 { left: -8%; top: 52%; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-floater {
      animation: hero-float calc(var(--motion-duration-slow) * 5) ease-in-out infinite alternate;
      animation-delay: var(--float-delay, 0s);
    }
  }

  @keyframes hero-float {
    from { transform: translateY(0); }
    to { transform: translateY(-12px); }
  }

  @media (max-width: 768px) {
    .hero-scene {
      right: 50%;
      top: auto;
      bottom: 12%;
      width: min(62vw, 280px);
      transform: translateX(50%);
    }

    .hero-floater--5,
    .hero-floater--6 {
      display: none;
    }
  }
</style>
