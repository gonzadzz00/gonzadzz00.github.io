---
import projects from '../data/projects.json';
import ImageCarousel from '../components/ImageCarousel.astro';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const projectsTitle = strings['section.projects.title'];
const projectsIntro = strings['projects.intro'];
const closeAria = strings['projects.closeAria'];
const viewProjectButton = strings['projects.viewProjectButton'];
const viewDiagramButton = strings['projects.viewDiagramButton'];
const flowchartTitle = strings['projects.flowchart.title'];
const flowchartSubtitle = strings['projects.flowchart.subtitle'];
const flowchartCloseAria = strings['projects.flowchart.closeAria'];
---

<section id="mis-proyectos" class="section">
  <h2 class="section-title reveal-title">
    <i class="fas fa-laptop-code section-icon"></i>
    <span data-i18n-es={projectsTitle.es} data-i18n-en={projectsTitle.en}>{projectsTitle.es}</span>
  </h2>

  <p class="projects-intro" data-i18n-es={projectsIntro.es} data-i18n-en={projectsIntro.en}>
    {projectsIntro.es}
  </p>

  <div class="projects-list reveal-stagger">
    {projects.map((project: any) => (
      <div class="card project-card" data-project-card data-open-project={project.id}>
        {project.images.length > 0 && (
          <div class="project-cover">
            <img src={project.images[0].src} alt={project.images[0].alt} loading="lazy" />
          </div>
        )}

        <div class="project-header-text">
          <h3 class="project-title" data-i18n-es={project.title.es} data-i18n-en={project.title.en}>{project.title.es}</h3>
          <div class="project-tools">
            {project.tools.map((tool: string) => (
              <span class="badge">{tool}</span>
            ))}
          </div>
        </div>

        <p class="project-description-preview" data-i18n-es={project.description.es} data-i18n-en={project.description.en}>{project.description.es}</p>

        <button type="button" class="btn-outline project-view-btn">
          <span data-i18n-es={viewProjectButton.es} data-i18n-en={viewProjectButton.en}>{viewProjectButton.es}</span>
        </button>
      </div>
    ))}
  </div>
</section>

{projects.map((project: any) => (
  <div class="project-modal-overlay" id={`project-modal-${project.id}`} data-project-modal>
    <div class="project-modal">
      <button
        class="project-modal-close"
        data-i18n-attr="aria-label"
        data-i18n-attr-es={closeAria.es}
        data-i18n-attr-en={closeAria.en}
        aria-label={closeAria.es}
      >
        <i class="fas fa-times"></i>
      </button>

      <div class="project-modal-content">
        <h3 class="project-title" data-i18n-es={project.title.es} data-i18n-en={project.title.en}>{project.title.es}</h3>
        <div class="project-tools">
          {project.tools.map((tool: string) => (
            <span class="badge">{tool}</span>
          ))}
        </div>
        <p class="project-description" data-i18n-es={project.description.es} data-i18n-en={project.description.en}>{project.description.es}</p>

        {project.images.length > 0 && (
          <ImageCarousel images={project.images} />
        )}

        <div class="project-links">
          {project.links.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <i class={link.icon}></i>
              <span data-i18n-es={link.label.es} data-i18n-en={link.label.en}>{link.label.es}</span>
            </a>
          ))}
          {project.id === 'caso-negocio' && (
            <button class="btn-outline" data-open-flowchart>
              <i class="fas fa-project-diagram"></i>
              <span data-i18n-es={viewDiagramButton.es} data-i18n-en={viewDiagramButton.en}>{viewDiagramButton.es}</span>
            </button>
          )}
        </div>
      </div>
    </div>
  </div>
))}

<!-- Modal del diagrama de flujo -->
<div class="flowchart-modal-overlay" id="flowchart-modal">
  <div class="flowchart-modal">
    <button
      class="flowchart-modal-close"
      data-i18n-attr="aria-label"
      data-i18n-attr-es={flowchartCloseAria.es}
      data-i18n-attr-en={flowchartCloseAria.en}
      aria-label={flowchartCloseAria.es}
    >
      <i class="fas fa-times"></i>
    </button>
    <div class="diagram-wrapper">
      <h3 data-i18n-es={flowchartTitle.es} data-i18n-en={flowchartTitle.en}>{flowchartTitle.es}</h3>
      <p class="subtitle" data-i18n-es={flowchartSubtitle.es} data-i18n-en={flowchartSubtitle.en}>{flowchartSubtitle.es}</p>
      <svg viewBox="0 0 920 1180" role="img" xmlns="http://www.w3.org/2000/svg">
        <title>Diagrama de flujo del pipeline de sincronización ShipsGo</title>
        <desc>Flujo completo del DAG: descubrimiento de bookings, registro contra la API ShipsGo, máquina de estados de sincronización, captura de cambios CDC y propagación de eventos en tiempo real vía n8n.</desc>
        <defs>
          <marker id="fc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
          <marker id="fc-arrow-dashed" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        <!-- ETAPA 1: DESCUBRIMIENTO -->
        <text class="section-label" x="40" y="32">01 · Descubrimiento</text>
        <line x1="40" y1="42" x2="880" y2="42" stroke="#d8d2c2" stroke-width="0.5"/>
        <g>
          <rect x="60" y="70" width="220" height="64" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
          <text class="th" x="170" y="96" text-anchor="middle" dominant-baseline="central" fill="#2C2C2A">tms.pedidos</text>
          <text class="ts" x="170" y="116" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">Base interna · Exportación</text>
        </g>
        <g>
          <rect x="350" y="70" width="220" height="64" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
          <text class="th" x="460" y="96" text-anchor="middle" dominant-baseline="central" fill="#3C3489">discover_new_bookings</text>
          <text class="ts" x="460" y="116" text-anchor="middle" dominant-baseline="central" fill="#534AB7">Filtra sub-pedidos · ventana 3d</text>
        </g>
        <g>
          <rect x="640" y="70" width="220" height="64" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
          <text class="th" x="750" y="96" text-anchor="middle" dominant-baseline="central" fill="#085041">shipsgo.booking</text>
          <text class="ts" x="750" y="116" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">Bulk insert · sync_status=PENDING</text>
        </g>
        <line x1="280" y1="102" x2="346" y2="102" stroke="#5F5E5A" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <line x1="570" y1="102" x2="636" y2="102" stroke="#5F5E5A" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <text class="ts" x="313" y="92" text-anchor="middle">SELECT</text>
        <text class="ts" x="603" y="92" text-anchor="middle">INSERT</text>
        <!-- ETAPA 2: SELECCIÓN PRIORIZADA -->
        <text class="section-label" x="40" y="190">02 · Selección priorizada</text>
        <line x1="40" y1="200" x2="880" y2="200" stroke="#d8d2c2" stroke-width="0.5"/>
        <g>
          <rect x="350" y="228" width="220" height="64" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
          <text class="th" x="460" y="254" text-anchor="middle" dominant-baseline="central" fill="#3C3489">get_bookings_to_sync</text>
          <text class="ts" x="460" y="274" text-anchor="middle" dominant-baseline="central" fill="#534AB7">batch_size=200 · elegibilidad</text>
        </g>
        <g>
          <rect x="60" y="228" width="220" height="120" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
          <text class="th" x="170" y="252" text-anchor="middle" fill="#633806">Cola de prioridades</text>
          <line x1="80" y1="266" x2="260" y2="266" stroke="#BA7517" stroke-width="0.5" stroke-dasharray="2 2"/>
          <text class="ts" x="80" y="288" fill="#854F0B">1. PENDING</text>
          <text class="ts" x="80" y="308" fill="#854F0B">2. RETRY</text>
          <text class="ts" x="80" y="328" fill="#854F0B">3. SYNCED (refresh)</text>
        </g>
        <g>
          <rect x="640" y="228" width="220" height="120" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
          <text class="th" x="750" y="252" text-anchor="middle" fill="#633806">Filtros de elegibilidad</text>
          <line x1="660" y1="266" x2="840" y2="266" stroke="#BA7517" stroke-width="0.5" stroke-dasharray="2 2"/>
          <text class="ts" x="660" y="288" fill="#854F0B">next_sync_attempt_at ≤ now()</text>
          <text class="ts" x="660" y="308" fill="#854F0B">sync_attempts &lt; 7</text>
          <text class="ts" x="660" y="328" fill="#854F0B">is_active = TRUE</text>
        </g>
        <line x1="280" y1="260" x2="346" y2="260" stroke="#BA7517" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <line x1="640" y1="260" x2="574" y2="260" stroke="#BA7517" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <!-- ETAPA 3: SINCRONIZACIÓN -->
        <text class="section-label" x="40" y="400">03 · Sincronización por booking · sync_booking()</text>
        <line x1="40" y1="410" x2="880" y2="410" stroke="#d8d2c2" stroke-width="0.5"/>
        <rect x="60" y="438" width="800" height="220" rx="12" fill="none" stroke="#888780" stroke-width="0.5" stroke-dasharray="4 4"/>
        <text class="ts" x="76" y="458" fill="#6b6862">sync_all_bookings_in_series · loop con 1s sleep entre llamadas</text>
        <g>
          <rect x="90" y="478" width="180" height="64" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
          <text class="th" x="180" y="504" text-anchor="middle" dominant-baseline="central" fill="#0C447C">register_booking()</text>
          <text class="ts" x="180" y="524" text-anchor="middle" dominant-baseline="central" fill="#185FA5">POST /ocean/shipments</text>
        </g>
        <g>
          <rect x="350" y="478" width="220" height="64" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
          <text class="th" x="460" y="504" text-anchor="middle" dominant-baseline="central" fill="#712B13">ShipsGo API</text>
          <text class="ts" x="460" y="524" text-anchor="middle" dominant-baseline="central" fill="#993C1D">Tracking multi-naviera</text>
        </g>
        <g>
          <rect x="650" y="478" width="180" height="64" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
          <text class="th" x="740" y="504" text-anchor="middle" dominant-baseline="central" fill="#0C447C">get_shipment_details()</text>
          <text class="ts" x="740" y="524" text-anchor="middle" dominant-baseline="central" fill="#185FA5">GET /shipments/&lt;id&gt;</text>
        </g>
        <g>
          <rect x="350" y="578" width="220" height="64" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
          <text class="th" x="460" y="604" text-anchor="middle" dominant-baseline="central" fill="#085041">upsert_full_snapshot()</text>
          <text class="ts" x="460" y="624" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">shipment + containers · transacción</text>
        </g>
        <line x1="270" y1="510" x2="346" y2="510" stroke="#185FA5" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <line x1="570" y1="510" x2="646" y2="510" stroke="#185FA5" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <line x1="740" y1="542" x2="740" y2="610" stroke="#0F6E56" stroke-width="1" fill="none" marker-end="url(#fc-arrow)"/>
        <line x1="740" y1="610" x2="574" y2="610" stroke="#0F6E56" stroke-width="1" fill="none" marker-end="url(#fc-arrow)"/>
        <path d="M460 292 L460 472" fill="none" stroke="#534AB7" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <!-- ETAPA 4: MÁQUINA DE ESTADOS -->
        <text class="section-label" x="40" y="700">04 · Resolución de estado · sync_status</text>
        <line x1="40" y1="710" x2="880" y2="710" stroke="#d8d2c2" stroke-width="0.5"/>
        <g>
          <rect x="40" y="740" width="156" height="80" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
          <text class="th" x="118" y="764" text-anchor="middle" dominant-baseline="central" fill="#2C2C2A">PENDING</text>
          <text class="ts" x="118" y="788" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">Recién descubierto</text>
          <text class="ts" x="118" y="806" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">delay inicial 1h</text>
        </g>
        <g>
          <rect x="216" y="740" width="156" height="80" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
          <text class="th" x="294" y="764" text-anchor="middle" dominant-baseline="central" fill="#633806">RETRY</text>
          <text class="ts" x="294" y="788" text-anchor="middle" dominant-baseline="central" fill="#854F0B">Backoff exponencial</text>
          <text class="ts" x="294" y="806" text-anchor="middle" dominant-baseline="central" fill="#854F0B">attempts² + interval</text>
        </g>
        <g>
          <rect x="392" y="740" width="156" height="80" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
          <text class="th" x="470" y="764" text-anchor="middle" dominant-baseline="central" fill="#085041">SYNCED</text>
          <text class="ts" x="470" y="788" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">Tracking activo</text>
          <text class="ts" x="470" y="806" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">refresh cada 2h</text>
        </g>
        <g>
          <rect x="568" y="740" width="156" height="80" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
          <text class="th" x="646" y="764" text-anchor="middle" dominant-baseline="central" fill="#3C3489">COMPLETED</text>
          <text class="ts" x="646" y="788" text-anchor="middle" dominant-baseline="central" fill="#534AB7">Entregado · DISCHARGED</text>
          <text class="ts" x="646" y="806" text-anchor="middle" dominant-baseline="central" fill="#534AB7">is_active = FALSE</text>
        </g>
        <g>
          <rect x="744" y="740" width="156" height="80" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
          <text class="th" x="822" y="764" text-anchor="middle" dominant-baseline="central" fill="#791F1F">PERMANENT_ERROR</text>
          <text class="ts" x="822" y="788" text-anchor="middle" dominant-baseline="central" fill="#A32D2D">Booking inválido</text>
          <text class="ts" x="822" y="806" text-anchor="middle" dominant-baseline="central" fill="#A32D2D">o max attempts (7)</text>
        </g>
        <path d="M460 642 L460 736" fill="none" stroke="#0F6E56" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <text class="ts" x="468" y="690" fill="#0F6E56">resultado del sync</text>
        <!-- ETAPA 5: PERSISTENCIA Y CDC -->
        <text class="section-label" x="40" y="880">05 · Persistencia y captura de cambios (CDC)</text>
        <line x1="40" y1="890" x2="880" y2="890" stroke="#d8d2c2" stroke-width="0.5"/>
        <g>
          <rect x="60" y="918" width="200" height="80" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
          <text class="th" x="160" y="942" text-anchor="middle" dominant-baseline="central" fill="#085041">shipsgo.shipment</text>
          <text class="ts" x="160" y="966" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">Estado actual del viaje</text>
          <text class="ts" x="160" y="984" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">ETA · vessel · status</text>
        </g>
        <g>
          <rect x="280" y="918" width="200" height="80" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
          <text class="th" x="380" y="942" text-anchor="middle" dominant-baseline="central" fill="#085041">shipsgo.container</text>
          <text class="ts" x="380" y="966" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">Tracking por contenedor</text>
          <text class="ts" x="380" y="984" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">last_movement</text>
        </g>
        <g>
          <rect x="500" y="918" width="180" height="80" rx="8" fill="#FBEAF0" stroke="#993556" stroke-width="0.5"/>
          <text class="th" x="590" y="942" text-anchor="middle" dominant-baseline="central" fill="#72243E">shipment_history</text>
          <text class="ts" x="590" y="966" text-anchor="middle" dominant-baseline="central" fill="#993556">CDC · insert-only</text>
          <text class="ts" x="590" y="984" text-anchor="middle" dominant-baseline="central" fill="#993556">changed_fields[]</text>
        </g>
        <g>
          <rect x="700" y="918" width="180" height="80" rx="8" fill="#FBEAF0" stroke="#993556" stroke-width="0.5"/>
          <text class="th" x="790" y="942" text-anchor="middle" dominant-baseline="central" fill="#72243E">container_history</text>
          <text class="ts" x="790" y="966" text-anchor="middle" dominant-baseline="central" fill="#993556">CDC · insert-only</text>
          <text class="ts" x="790" y="984" text-anchor="middle" dominant-baseline="central" fill="#993556">por container_number</text>
        </g>
        <!-- ETAPA 6: EVENTOS EN TIEMPO REAL -->
        <text class="section-label" x="40" y="1050">06 · Eventos en tiempo real</text>
        <line x1="40" y1="1060" x2="880" y2="1060" stroke="#d8d2c2" stroke-width="0.5"/>
        <g>
          <rect x="60" y="1088" width="240" height="64" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
          <text class="th" x="180" y="1114" text-anchor="middle" dominant-baseline="central" fill="#633806">ETA change detection</text>
          <text class="ts" x="180" y="1134" text-anchor="middle" dominant-baseline="central" fill="#854F0B">freeze 1d · eta_diff_days</text>
        </g>
        <g>
          <rect x="360" y="1088" width="200" height="64" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
          <text class="th" x="460" y="1114" text-anchor="middle" dominant-baseline="central" fill="#712B13">n8n · webhooks</text>
          <text class="ts" x="460" y="1134" text-anchor="middle" dominant-baseline="central" fill="#993C1D">Lógica de eventos</text>
        </g>
        <g>
          <rect x="620" y="1088" width="240" height="64" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
          <text class="th" x="740" y="1114" text-anchor="middle" dominant-baseline="central" fill="#2C2C2A">Equipos · BD interna</text>
          <text class="ts" x="740" y="1134" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">Notificación + actualización</text>
        </g>
        <line x1="300" y1="1120" x2="356" y2="1120" stroke="#993C1D" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <line x1="560" y1="1120" x2="616" y2="1120" stroke="#993C1D" stroke-width="1" marker-end="url(#fc-arrow)"/>
        <path d="M460 642 L460 670 L160 670 L160 914" fill="none" stroke="#0F6E56" stroke-width="0.5" stroke-dasharray="3 3"/>
        <path d="M460 670 L380 670 L380 914" fill="none" stroke="#0F6E56" stroke-width="0.5" stroke-dasharray="3 3"/>
        <path d="M460 670 L590 670 L590 914" fill="none" stroke="#993556" stroke-width="0.5" stroke-dasharray="3 3"/>
        <path d="M590 670 L790 670 L790 914" fill="none" stroke="#993556" stroke-width="0.5" stroke-dasharray="3 3"/>
        <path d="M160 998 L160 1086" fill="none" stroke="#854F0B" stroke-width="0.5" stroke-dasharray="3 3" marker-end="url(#fc-arrow-dashed)"/>
      </svg>
      <div class="legend">
        <div class="legend-item"><span class="legend-swatch" style="background:#EEEDFE;border-color:#534AB7"></span>Tareas Airflow</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#E6F1FB;border-color:#185FA5"></span>API ShipsGo</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#E1F5EE;border-color:#0F6E56"></span>Tablas operativas</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#FBEAF0;border-color:#993556"></span>Tablas CDC (historial)</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#FAEEDA;border-color:#854F0B"></span>Lógica de control</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#FAECE7;border-color:#993C1D"></span>Servicios externos</div>
      </div>
    </div>
  </div>
</div>

<script>
  function openModal(modal: HTMLElement | null) {
    if (!modal) return;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(modal: HTMLElement | null) {
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function initProjectModals() {
    document.querySelectorAll<HTMLElement>('[data-open-project]').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const id = trigger.getAttribute('data-open-project');
        openModal(document.getElementById(`project-modal-${id}`));
      });
    });

    document.querySelectorAll<HTMLElement>('[data-project-modal]').forEach(modal => {
      const closeBtn = modal.querySelector('.project-modal-close');
      closeBtn?.addEventListener('click', () => closeModal(modal));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal(modal);
      });
    });
  }

  function initFlowchartModal() {
    const modal = document.getElementById('flowchart-modal');
    const openBtn = document.querySelector('[data-open-flowchart]');
    const closeBtn = modal?.querySelector('.flowchart-modal-close');

    openBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openModal(modal);
    });

    closeBtn?.addEventListener('click', () => closeModal(modal));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal);
    });
  }

  function initModalEscapeHandling() {
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;

      if (document.querySelector('[data-lightbox].active')) return;

      const flowchart = document.getElementById('flowchart-modal');
      if (flowchart?.classList.contains('active')) {
        closeModal(flowchart);
        return;
      }

      document.querySelectorAll<HTMLElement>('[data-project-modal].active').forEach(closeModal);
    });
  }

  initProjectModals();
  initFlowchartModal();
  initModalEscapeHandling();
  document.addEventListener('astro:after-swap', () => {
    initProjectModals();
    initFlowchartModal();
  });
</script>

