---
import siteConfig from '../data/site-config.json';
import focusAreas from '../data/focus-areas.json';
import techStack from '../data/tech-stack.json';
import uiStrings from '../data/ui-strings.json';
import Illustration from '../components/Illustration.astro';
import BrainScene from '../components/BrainScene.astro';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const aboutTitle = strings['section.about.title'];
const focusAreasTitle = strings['section.about.focusAreas'];
const techStackTitle = strings['section.about.techStack'];
---

<section id="mi-perfil" class="section">
  <h2 class="section-title reveal-title">
    <i class="fas fa-user section-icon"></i>
    <span data-i18n-es={aboutTitle.es} data-i18n-en={aboutTitle.en}>{aboutTitle.es}</span>
  </h2>

  <div class="about-intro">
    <div class="about-bio">
      {siteConfig.bio.map((paragraph: { es: string; en: string }) => (
        <p data-i18n-es={paragraph.es} data-i18n-en={paragraph.en}>{paragraph.es}</p>
      ))}
    </div>
    <BrainScene
      modelSrc="/models/hero-brain.glb"
      posterSrc="/images/hero-poster.webp"
      floatingIcons={['Python', 'PyTorch', 'Apache Airflow', 'n8n', 'Docker', 'LangChain']}
    />
  </div>

  <h3 class="subsection-title">
    <i class="fas fa-bullseye section-icon"></i>
    <span data-i18n-es={focusAreasTitle.es} data-i18n-en={focusAreasTitle.en}>{focusAreasTitle.es}</span>
  </h3>

  <div class="grid-3 reveal-stagger">
    {focusAreas.map((area: any) => (
      <div class="card focus-card" data-tilt>
        <Illustration assetId={area.illustration} decorative class="focus-art" />
        <div class="focus-icon">
          <i class={area.icon}></i>
        </div>
        <h4 data-i18n-es={area.name.es} data-i18n-en={area.name.en}>{area.name.es}</h4>
        <ul class="focus-skills">
          {area.skills.map((skill: { es: string; en: string }) => (
            <li data-i18n-es={skill.es} data-i18n-en={skill.en}>{skill.es}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h3 class="subsection-title">
    <i class="fas fa-wrench section-icon"></i>
    <span data-i18n-es={techStackTitle.es} data-i18n-en={techStackTitle.en}>{techStackTitle.es}</span>
  </h3>

  <div class="tech-badges reveal-chips" id="tech-badges">
    <div class="tech-badges-track" id="tech-badges-track">
      {techStack.map((tech: any, i: number) => (
        <div class="tech-chip" style={`--tech-color: ${tech.color}; --i: ${i}`}>
          <span class="tech-chip-icon">
            <img src={tech.iconUrl} alt="" loading="lazy" />
          </span>
          <span class="tech-chip-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initTechAutoSlide() {
    const wrapper = document.getElementById('tech-badges');
    const track = document.getElementById('tech-badges-track');
    if (!wrapper || !track) return;

    function updateDistance() {
      if (!wrapper || !track) return;
      const distance = track.scrollWidth - wrapper.clientWidth;
      track.style.setProperty('--tech-scroll-distance', `-${Math.max(distance, 0)}px`);
    }

    updateDistance();
    window.addEventListener('resize', updateDistance);
  }

  initTechAutoSlide();
  document.addEventListener('astro:after-swap', initTechAutoSlide);
</script>

<style>
  /* Projects follows right after the tech strip: keep the gap between them tight */
  #mi-perfil {
    padding-bottom: var(--space-lg);
  }

  .about-intro {
    margin-bottom: var(--space-2xl);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    gap: var(--space-2xl);
    align-items: center;
  }

  .about-bio {
    max-width: 800px;
  }

  .focus-art {
    width: 96px;
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 900px) {
    .about-intro {
      grid-template-columns: 1fr;
    }

    .about-intro :global(.brain-scene) {
      width: min(80vw, 320px);
    }
  }

  .about-bio p {
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .subsection-title {
    font-size: var(--text-2xl);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .subsection-title .section-icon {
    font-size: var(--text-xl);
  }

  .focus-card {
    text-align: left;
  }

  .focus-icon {
    font-size: var(--text-3xl);
    color: var(--accent-color);
    margin-bottom: var(--space-sm);
  }

  .focus-icon i {
    display: block;
  }

  .focus-card h4 {
    margin-bottom: var(--space-sm);
  }

  .focus-skills {
    list-style: none;
    padding: 0;
  }

  .focus-skills li {
    padding: var(--space-xs) 0;
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.5;
    border-bottom: 1px solid var(--border-color);
  }

  .focus-skills li:last-child {
    border-bottom: none;
  }

  .tech-badges {
    overflow: hidden;
    margin-top: var(--space-md);
    padding: var(--space-lg) var(--space-xs) var(--space-sm);
    margin-left: calc(var(--space-xs) * -1);
    margin-right: calc(var(--space-xs) * -1);
  }

  .tech-badges-track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-md);
    width: max-content;
    animation: tech-auto-slide 22s ease-in-out infinite alternate;
  }

  .tech-badges:hover .tech-badges-track {
    animation-play-state: paused;
  }

  @keyframes tech-auto-slide {
    from { transform: translateX(0); }
    to { transform: translateX(var(--tech-scroll-distance, 0)); }
  }

  .tech-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md) var(--space-xs) var(--space-xs);
    border-radius: 999px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    transition: box-shadow var(--transition-normal),
                transform var(--transition-fast);
  }

  .tech-chip:hover {
    box-shadow: 0 0 20px var(--tech-color);
    transform: translateY(-3px);
  }

  /* Staggered entrance: chips fade/slide in once the strip scrolls into view */
  .reveal-chips:not(.visible) .tech-chip {
    opacity: 0;
  }

  .reveal-chips.visible .tech-chip {
    animation: tech-chip-in var(--motion-duration-base) var(--motion-ease) backwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  @keyframes tech-chip-in {
    from { opacity: 0; transform: translateY(14px); }
  }

  .tech-chip-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    padding: 7px;
  }

  .tech-chip-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tech-chip-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-color);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-chips:not(.visible) .tech-chip {
      opacity: 1;
    }

    .reveal-chips.visible .tech-chip {
      animation: none;
    }

    .tech-badges-track {
      animation: none;
      transform: none !important;
      flex-wrap: wrap;
      width: auto;
    }

    .tech-chip:hover {
      transform: none;
    }
  }
</style>
