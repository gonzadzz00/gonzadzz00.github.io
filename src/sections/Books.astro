---
import books from '../data/books.json';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const booksTitle = strings['section.books.title'];
---

{books.length > 0 && (
  <section id="libros" class="section">
    <h2 class="section-title reveal-title">
      <i class="fas fa-book-open section-icon"></i>
      <span data-i18n-es={booksTitle.es} data-i18n-en={booksTitle.en}>{booksTitle.es}</span>
    </h2>

    <div class="grid-3 reveal-stagger">
      {books.map((book: any) => (
        <div class="card book-card">
          {book.coverImage && (
            <img src={book.coverImage} alt={`Portada de ${book.title}`} class="book-cover" loading="lazy" />
          )}
          <h4 class="book-title">{book.title}</h4>
          <p class="book-author">{book.author}</p>
          {book.category && <span class="badge">{book.category}</span>}
          {book.note && <p class="book-note" data-i18n-es={book.note.es} data-i18n-en={book.note.en}>{book.note.es}</p>}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
  }

  .book-cover {
    width: 190px;
    height: 270px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .book-title {
    font-size: var(--text-base);
    margin: 0;
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    margin: 0;
  }

  .book-note {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.5;
    margin: 0;
  }
</style>
