---
import books from '../data/books.json';
---

{books.length > 0 && (
  <section id="libros" class="section">
    <h2 class="section-title">
      <span class="emoji-icon">&#128214;</span>
      Libros
    </h2>

    <div class="grid-3">
      {books.map((book: any) => (
        <div class="card book-card">
          {book.coverImage && (
            <img src={book.coverImage} alt={`Portada de ${book.title}`} class="book-cover" loading="lazy" />
          )}
          <h4 class="book-title">{book.title}</h4>
          <p class="book-author">{book.author}</p>
          {book.category && <span class="badge">{book.category}</span>}
          {book.note && <p class="book-note">{book.note}</p>}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
  }

  .book-cover {
    width: 140px;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .book-title {
    font-size: var(--text-base);
    margin: 0;
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    margin: 0;
  }

  .book-note {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.5;
    margin: 0;
  }
</style>
