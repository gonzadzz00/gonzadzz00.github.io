---
import siteConfig from '../data/site-config.json';
import uiStrings from '../data/ui-strings.json';
import HeroTraces from '../components/HeroTraces.astro';
import HeroDecor from '../components/HeroDecor.astro';
import HeroChip from '../components/HeroChip.astro';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const terms = [
  { ill: 'wf', color: '#4de0d6', text: strings['hero.term.automation'] },
  { ill: 'nn', color: '#a78bfa', text: strings['hero.term.ml'] },
  { ill: 'cv', color: '#27b5f0', text: strings['hero.term.cv'] },
];
const ctaProjects = strings['hero.cta.projects'];
const ctaContact = strings['hero.cta.contact'];
---

<header class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <HeroTraces />
  <HeroDecor />
  <HeroChip />
  <div class="hero-content">
    <h1 class="hero-title" aria-label={siteConfig.ownerName}>
      <span class="scramble-text" aria-hidden="true" data-scramble={siteConfig.ownerName}>{siteConfig.ownerName}</span>
    </h1>
    <p class="hero-tagline" data-i18n-es={siteConfig.tagline.es} data-i18n-en={siteConfig.tagline.en}>{siteConfig.tagline.es}</p>
    <ul class="hero-terms" aria-label={strings['hero.termsAria'].es} data-i18n-attr="aria-label" data-i18n-attr-es={strings['hero.termsAria'].es} data-i18n-attr-en={strings['hero.termsAria'].en}>
      {terms.map(t => (
        <li>
          <a
            class="hero-term"
            href="#mis-proyectos"
            data-ill={t.ill}
            style={`--accent: ${t.color}`}
            data-i18n-es={t.text.es}
            data-i18n-en={t.text.en}
          >{t.text.es}</a>
        </li>
      ))}
    </ul>
    <div class="hero-ctas">
      <a class="hero-cta hero-cta--primary" href="#mis-proyectos" data-i18n-es={ctaProjects.es} data-i18n-en={ctaProjects.en}>{ctaProjects.es}</a>
      <a class="hero-cta hero-cta--secondary" href="#contacto" data-i18n-es={ctaContact.es} data-i18n-en={ctaContact.en}>{ctaContact.es}</a>
    </div>
  </div>
</header>

<script>
  function scrambleElement(el: HTMLElement, target: string) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!<>-_\\/[]{}=+*^#?';
    const revealDelay = 28;
    const lockDuration = 380;
    let startTime: number | null = null;

    // Freeze the box at the final text size so random glyph widths never shift the layout
    const box = el.getBoundingClientRect();
    el.style.width = `${box.width}px`;
    el.style.height = `${box.height}px`;
    el.style.whiteSpace = 'nowrap';
    el.style.overflow = 'hidden';
    el.style.verticalAlign = 'top';

    el.classList.add('is-scrambling');

    function frame(now: number) {
      if (startTime === null) startTime = now;
      const elapsed = now - startTime;
      let output = '';
      let allLocked = true;

      for (let i = 0; i < target.length; i++) {
        const char = target[i];
        if (char === ' ') {
          output += ' ';
          continue;
        }
        const charEnd = i * revealDelay + lockDuration;
        if (elapsed >= charEnd) {
          output += char;
        } else {
          allLocked = false;
          output += chars[Math.floor(Math.random() * chars.length)];
        }
      }

      el.textContent = output;

      if (!allLocked) {
        requestAnimationFrame(frame);
      } else {
        el.textContent = target;
        el.classList.remove('is-scrambling');
        ['width', 'height', 'whiteSpace', 'overflow', 'verticalAlign'].forEach(prop => el.style.removeProperty(prop.replace(/[A-Z]/g, c => `-${c.toLowerCase()}`)));
      }
    }

    requestAnimationFrame(frame);
  }

  function initTitleScramble() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.scramble-text').forEach(el => {
      const target = el.getAttribute('data-scramble') ?? el.textContent ?? '';
      if (prefersReducedMotion) {
        el.textContent = target;
        return;
      }
      scrambleElement(el, target);
    });
  }

  // Pause the artwork animations while the hero is off screen
  function initHeroVisibility() {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    new IntersectionObserver(entries => {
      hero.classList.toggle('is-offscreen', !entries.some(e => e.isIntersecting));
    }).observe(hero);
  }

  // Terms light up their illustration (hover, keyboard focus, or first tap on touch)
  function initHeroTerms() {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    const terms = Array.from(hero.querySelectorAll<HTMLAnchorElement>('.hero-term'));
    const wide = window.matchMedia('(min-width: 768px)');
    const coarse = window.matchMedia('(pointer: coarse)');
    const set = (ill: string | null) => {
      if (ill && wide.matches) hero.setAttribute('data-active', ill);
      else hero.removeAttribute('data-active');
    };

    terms.forEach(term => {
      const ill = term.dataset.ill ?? null;
      term.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') set(ill); });
      term.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') set(null); });
      term.addEventListener('focus', () => { if (term.matches(':focus-visible')) set(ill); });
      term.addEventListener('blur', () => set(null));
      // Touch: the first tap activates, a second tap on the same term follows the link
      term.addEventListener('click', e => {
        if (!coarse.matches || !wide.matches) return;
        if (hero.getAttribute('data-active') !== ill) {
          e.preventDefault();
          set(ill);
        }
      });
    });

    document.addEventListener('pointerdown', e => {
      if (!(e.target as Element).closest('.hero-term')) set(null);
    });
    wide.addEventListener('change', () => set(null));
  }

  initTitleScramble();
  initHeroVisibility();
  initHeroTerms();
  document.addEventListener('astro:after-swap', () => {
    initTitleScramble();
    initHeroVisibility();
    initHeroTerms();
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    border-bottom: 4px solid var(--accent-color);
  }

  /* Same palette as the previous cover: teal light top-left fading into deep navy */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 75% at 0% 12%, rgba(84, 146, 171, 0.8), transparent 62%),
      radial-gradient(ellipse 45% 60% at 74% 48%, rgba(18, 98, 121, 0.6), transparent 68%),
      linear-gradient(160deg, #0f4162 0%, #0b2e4c 34%, #061b36 66%, #030b20 100%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.3px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 70% 50%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 70% 50%, #000, transparent 75%);
    opacity: 0.55;
  }

  /* ---- text block (above the chip and the illustrations) ---- */
  .hero-content {
    position: absolute;
    z-index: 4;
    left: 8vw;
    top: 38vh;
    transform: translateY(-50%);
    max-width: 40vw;
    text-align: left;
    color: #fff;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(44px, 4.4vw, 84px);
    line-height: 1.1;
    color: #fff;
    margin: 0 0 8px;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65);
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  .scramble-text {
    display: inline-block;
    transition: color 0.4s ease, text-shadow 0.4s ease;
  }

  .scramble-text.is-scrambling {
    color: var(--accent-color-2);
    text-shadow: 0 0 16px rgba(123, 47, 247, 0.55);
  }

  .hero-tagline {
    font-size: clamp(16px, 1.3vw, 28px);
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
  }

  .hero-terms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    font-size: clamp(14px, 1.05vw, 22px);
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
  }

  .hero-term {
    color: #fff;
    font-weight: 600;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    border-radius: 4px;
    transition: text-decoration-color 0.3s ease-out;
  }

  .hero-term:hover {
    color: #fff;
  }

  .hero-term:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 12px;
    border: 2px solid transparent;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, background-color 0.2s ease-out;
  }

  .hero-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .hero-cta--primary {
    background: #27b5f0;
    color: #061b36;
  }

  .hero-cta--primary:hover {
    color: #061b36;
    background: #4cc6f7;
    box-shadow: 0 0 18px rgba(39, 181, 240, 0.55);
    transform: translateY(-1px);
  }

  .hero-cta--secondary {
    border-color: #4de0d6;
    background: transparent;
    color: #fff;
  }

  .hero-cta--secondary:hover {
    color: #fff;
    background: rgba(77, 224, 214, 0.14);
    transform: translateY(-1px);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Tablet */
  @media (max-width: 1279px) {
    .hero-content {
      left: 6vw;
      max-width: 55vw;
    }
  }

  /* Mobile: text on top and centred, chip underneath */
  @media (max-width: 767px) {
    .hero {
      min-height: max(100svh, 660px);
    }

    .hero-content {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      max-width: none;
      padding: calc(var(--navbar-height, 76px) + 28px) 24px 0;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(34px, 9vw, 48px);
    }

    .hero-terms {
      flex-direction: column;
      align-items: center;
      gap: 10px;
      font-size: 16px;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 12px;
    }

    .hero-cta {
      width: 100%;
    }
  }

  /* Landscape phones: text and chip only */
  @media (max-height: 499px) and (min-width: 768px) {
    .hero {
      min-height: 100vh;
    }

    .hero-content {
      top: 56vh;
    }

    .hero-title {
      font-size: clamp(28px, 8vh, 40px);
    }

    .hero-terms {
      margin-top: 10px;
    }

    .hero-ctas {
      margin-top: 10px;
    }

    .hero-cta {
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-tagline,
    .hero-terms,
    .hero-ctas {
      opacity: 1;
      animation: none;
      transform: none;
    }

    .hero-cta:hover {
      transform: none;
    }
  }
</style>
