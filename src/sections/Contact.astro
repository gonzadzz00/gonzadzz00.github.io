---
import siteConfig from '../data/site-config.json';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const thanksTitle = strings['contact.thanksTitle'];
const cta = strings['contact.cta'];
---

<section id="contacto" class="section">
  <div class="contact-container">
    <div class="contact-photo">
      <img src={siteConfig.profileImage} alt={siteConfig.ownerName} loading="lazy" />
    </div>

    <div class="contact-content">
      <div class="card contact-card">
        <div class="contact-icon">
          <i class="fas fa-handshake"></i>
        </div>
        <h2 data-i18n-es={thanksTitle.es} data-i18n-en={thanksTitle.en}>{thanksTitle.es}</h2>
        <p data-i18n-es={siteConfig.contactMessage.es} data-i18n-en={siteConfig.contactMessage.en}>{siteConfig.contactMessage.es}</p>
        <a href={`mailto:${siteConfig.contactEmail}`} class="email-link">
          <i class="fas fa-envelope"></i>
          {siteConfig.contactEmail}
        </a>
        <p class="contact-cta" data-i18n-es={cta.es} data-i18n-en={cta.en}>{cta.es}</p>
      </div>

      <div class="social-links">
        {siteConfig.socialLinks.map((link: any) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-container {
    display: flex;
    gap: var(--space-2xl);
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-photo {
    flex-shrink: 0;
  }

  .contact-photo img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--accent-color);
  }

  .contact-content {
    flex: 1;
  }

  .contact-card {
    text-align: center;
  }

  .contact-icon {
    font-size: var(--text-3xl);
    color: var(--accent-color);
    margin-bottom: var(--space-md);
  }

  .contact-card h2 {
    font-size: var(--text-2xl);
  }

  .contact-card p {
    color: var(--secondary-text);
    line-height: 1.6;
  }

  .email-link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
    color: var(--accent-color);
    font-weight: 600;
    font-size: var(--text-lg);
    margin: var(--space-md) 0;
  }

  .contact-cta {
    font-weight: 600;
    color: var(--text-color) !important;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }

  .social-links a {
    font-size: var(--text-2xl);
    color: var(--text-color);
    transition: color var(--transition-fast),
                transform var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--accent-color);
    transform: translateY(-2px);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .contact-container {
      flex-direction: column;
      text-align: center;
    }

    .contact-photo img {
      width: 140px;
      height: 140px;
    }
  }
</style>
