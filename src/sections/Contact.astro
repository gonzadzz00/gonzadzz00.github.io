---
import siteConfig from '../data/site-config.json';
import uiStrings from '../data/ui-strings.json';
import Illustration from '../components/Illustration.astro';

// Brand colour per social network (GitHub follows the theme text colour)
const brandColors: Record<string, string> = {
  LinkedIn: '#0A66C2',
  Email: 'var(--accent-color)',
  WhatsApp: '#25D366',
};

const strings: Record<string, { es: string; en: string }> = uiStrings;
const thanksTitle = strings['contact.thanksTitle'];
const cta = strings['contact.cta'];
const writeMe = strings['contact.writeMe'];
---

<section id="contacto" class="section">
  <div class="contact-container reveal">
    <div class="contact-photo">
      <img src={siteConfig.profileImage} alt={siteConfig.ownerName} loading="lazy" />
      <Illustration
        assetId="contact"
        float
        class="contact-art"
        alt={{ es: 'Ilustración de correo y conversación', en: 'Illustration of mail and conversation' }}
      />
    </div>

    <div class="contact-content">
      <div class="card contact-card">
        <div class="contact-icon">
          <i class="fas fa-handshake"></i>
        </div>
        <h2 class="reveal-title" data-i18n-es={thanksTitle.es} data-i18n-en={thanksTitle.en}>{thanksTitle.es}</h2>
        <p data-i18n-es={siteConfig.contactMessage.es} data-i18n-en={siteConfig.contactMessage.en}>{siteConfig.contactMessage.es}</p>
        <a href={`mailto:${siteConfig.contactEmail}`} class="email-link">
          <i class="fas fa-envelope"></i>
          {siteConfig.contactEmail}
        </a>
        <p class="contact-cta" data-i18n-es={cta.es} data-i18n-en={cta.en}>{cta.es}</p>
        <a href={`mailto:${siteConfig.contactEmail}`} class="btn-primary contact-write">
          <i class="fas fa-paper-plane contact-write-icon" aria-hidden="true"></i>
          <span data-i18n-es={writeMe.es} data-i18n-en={writeMe.en}>{writeMe.es}</span>
        </a>
      </div>

      <div class="social-links reveal-chips">
        {siteConfig.socialLinks.map((link: any, i: number) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            style={`--i: ${i}; --brand: ${brandColors[link.label] ?? 'var(--text-color)'}; --on-brand: ${brandColors[link.label] ? '#fff' : 'var(--card-bg)'}`}
          >
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-container {
    display: flex;
    gap: var(--space-2xl);
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-photo {
    position: relative;
    flex-shrink: 0;
  }

  .contact-photo img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--accent-color);
  }

  .contact-content {
    flex: 1;
  }

  .contact-card {
    text-align: center;
  }

  .contact-icon {
    font-size: var(--text-3xl);
    color: var(--accent-color);
    margin-bottom: var(--space-md);
  }

  .contact-card h2 {
    font-size: var(--text-2xl);
  }

  .contact-card p {
    color: var(--secondary-text);
    line-height: 1.6;
  }

  .email-link {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
    color: var(--accent-color);
    font-weight: 600;
    font-size: var(--text-lg);
    margin: var(--space-md) 0;
  }

  /* Primary CTA: idle pulse ring, light sweep and a paper plane that takes off on hover */
  .contact-write {
    margin-top: var(--space-sm);
    overflow: hidden;
    animation: contact-pulse calc(var(--motion-duration-slow) * 3.5) ease-out infinite;
  }

  .contact-write::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 40%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transform: skewX(-20deg);
    pointer-events: none;
  }

  .contact-write:hover,
  .contact-write:focus-visible {
    animation-play-state: paused;
  }

  .contact-write:hover::before,
  .contact-write:focus-visible::before {
    left: 130%;
    transition: left calc(var(--motion-duration-slow) * 0.9) var(--motion-ease);
  }

  .contact-write-icon {
    transition: transform var(--motion-duration-base) var(--motion-ease);
  }

  .contact-write:hover .contact-write-icon,
  .contact-write:focus-visible .contact-write-icon {
    transform: translate(4px, -4px) rotate(-14deg) scale(1.15);
  }

  @keyframes contact-pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 164, 239, 0.45), var(--glow-shadow); }
    70%, 100% { box-shadow: 0 0 0 14px rgba(0, 164, 239, 0), var(--glow-shadow); }
  }

  .email-link {
    background: linear-gradient(currentColor, currentColor) no-repeat 50% 100% / 0 2px;
    transition: background-size var(--motion-duration-base) var(--motion-ease);
  }

  .email-link:hover,
  .email-link:focus-visible {
    background-size: 60% 2px;
  }

  .contact-art {
    width: 180px;
    margin: var(--space-lg) auto 0;
  }

  .contact-cta {
    font-weight: 600;
    color: var(--text-color) !important;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }

  .social-links a {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    font-size: var(--text-xl);
    color: var(--text-color);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    transition: color var(--motion-duration-fast) var(--motion-ease),
                background-color var(--motion-duration-fast) var(--motion-ease),
                border-color var(--motion-duration-fast) var(--motion-ease),
                transform var(--motion-duration-base) var(--motion-ease),
                box-shadow var(--motion-duration-base) var(--motion-ease);
  }

  /* Ring that expands from the button while it is hovered */
  .social-links a::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 2px solid var(--brand);
    opacity: 0;
    pointer-events: none;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    color: var(--on-brand, #fff);
    background: var(--brand);
    border-color: var(--brand);
    transform: translateY(-6px) scale(1.1);
    box-shadow: 0 12px 24px color-mix(in srgb, var(--brand) 45%, transparent);
    opacity: 1;
  }

  .social-links a:hover::after,
  .social-links a:focus-visible::after {
    animation: social-ring calc(var(--motion-duration-slow) * 1.2) ease-out infinite;
  }

  .social-links a i {
    transition: transform var(--motion-duration-base) var(--motion-ease);
  }

  .social-links a:hover i,
  .social-links a:focus-visible i {
    animation: social-wiggle var(--motion-duration-slow) var(--motion-ease);
  }

  /* Staggered pop-in when the row scrolls into view */
  .social-links.reveal-chips:not(.visible) a {
    opacity: 0;
  }

  .social-links.reveal-chips.visible a {
    animation: social-pop var(--motion-duration-base) var(--motion-ease) backwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @keyframes social-pop {
    from { opacity: 0; transform: translateY(16px) scale(0.6); }
  }

  @keyframes social-ring {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(1.7); opacity: 0; }
  }

  @keyframes social-wiggle {
    0% { transform: rotate(0); }
    25% { transform: rotate(-14deg) scale(1.1); }
    60% { transform: rotate(10deg) scale(1.1); }
    100% { transform: rotate(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-write,
    .social-links.reveal-chips.visible a,
    .social-links a:hover i,
    .social-links a:focus-visible i,
    .social-links a:hover::after,
    .social-links a:focus-visible::after {
      animation: none;
    }

    .social-links.reveal-chips:not(.visible) a {
      opacity: 1;
    }

    .contact-write:hover .contact-write-icon,
    .contact-write:focus-visible .contact-write-icon,
    .social-links a:hover,
    .social-links a:focus-visible {
      transform: none;
    }

    .contact-write::before {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .contact-container {
      flex-direction: column;
      text-align: center;
    }

    .contact-photo img {
      width: 140px;
      height: 140px;
    }
  }
</style>
