---
import certifications from '../data/certifications.json';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const certsTitle = strings['section.certifications.title'];
const verifyButton = strings['certifications.verifyButton'];
const prevAria = strings['certifications.prevAria'];
const nextAria = strings['certifications.nextAria'];
---

{certifications.length > 0 && (
  <section id="certificaciones" class="section">
    <h2 class="section-title reveal-title">
      <i class="fas fa-certificate section-icon"></i>
      <span data-i18n-es={certsTitle.es} data-i18n-en={certsTitle.en}>{certsTitle.es}</span>
    </h2>

    <div class="certs-carousel">
      <button
        type="button"
        class="certs-nav-btn certs-nav-prev"
        id="certs-prev"
        data-i18n-attr="aria-label"
        data-i18n-attr-es={prevAria.es}
        data-i18n-attr-en={prevAria.en}
        aria-label={prevAria.es}
      >
        <i class="fas fa-chevron-left"></i>
      </button>

      <div class="certs-list reveal-stagger" id="certs-list">
        {certifications.map((cert: any, i: number) => (
          <div class="card cert-card">
            <div class="cert-image">
              <img
                src={cert.certificateImage || cert.issuerLogo}
                alt={`Certificado ${cert.issuer}`}
                loading="lazy"
                data-lightbox-open
                data-lightbox-index={i}
              />
            </div>

            <h3 class="cert-name" data-i18n-es={cert.name.es} data-i18n-en={cert.name.en}>{cert.name.es}</h3>
            <p class="cert-issuer">{cert.issuer} &middot; {cert.date}</p>

            {cert.verificationUrl && cert.verificationUrl !== "" && (
              <a href={cert.verificationUrl} target="_blank" rel="noopener noreferrer" class="btn-outline cert-verify">
                <i class="fas fa-external-link-alt"></i>
                <span data-i18n-es={verifyButton.es} data-i18n-en={verifyButton.en}>{verifyButton.es}</span>
              </a>
            )}
          </div>
        ))}
      </div>

      <button
        type="button"
        class="certs-nav-btn certs-nav-next"
        id="certs-next"
        data-i18n-attr="aria-label"
        data-i18n-attr-es={nextAria.es}
        data-i18n-attr-en={nextAria.en}
        aria-label={nextAria.es}
      >
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>

    <div class="cert-lightbox-overlay" data-cert-lightbox tabindex="-1">
      <button
        class="cert-lightbox-close"
        data-cert-lightbox-close
        data-i18n-attr="aria-label"
        data-i18n-attr-es="Cerrar vista previa"
        data-i18n-attr-en="Close preview"
        aria-label="Cerrar vista previa"
      >
        <i class="fas fa-times"></i>
      </button>

      <button
        class="cert-lightbox-btn prev"
        data-cert-lightbox-prev
        data-i18n-attr="aria-label"
        data-i18n-attr-es="Certificado anterior"
        data-i18n-attr-en="Previous certificate"
        aria-label="Certificado anterior"
      >
        &#10094;
      </button>
      <button
        class="cert-lightbox-btn next"
        data-cert-lightbox-next
        data-i18n-attr="aria-label"
        data-i18n-attr-es="Certificado siguiente"
        data-i18n-attr-en="Next certificate"
        aria-label="Certificado siguiente"
      >
        &#10095;
      </button>

      <img class="cert-lightbox-img" data-cert-lightbox-img src="" alt="" />
    </div>
  </section>
)}

<script>
  function initCertsCarousel() {
    const list = document.getElementById('certs-list');
    const prevBtn = document.getElementById('certs-prev');
    const nextBtn = document.getElementById('certs-next');
    if (!list || !prevBtn || !nextBtn) return;

    function updateButtons() {
      if (!list) return;
      const maxScroll = list.scrollWidth - list.clientWidth;
      prevBtn?.toggleAttribute('disabled', list.scrollLeft <= 4);
      nextBtn?.toggleAttribute('disabled', list.scrollLeft >= maxScroll - 4);
    }

    function scrollByPage(direction: number) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      list?.scrollBy({
        left: direction * (list?.clientWidth ?? 0),
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    }

    prevBtn.addEventListener('click', () => scrollByPage(-1));
    nextBtn.addEventListener('click', () => scrollByPage(1));

    list.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }

  function initCertsLightbox() {
    const lightbox = document.querySelector<HTMLElement>('[data-cert-lightbox]');
    const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-cert-lightbox-img]');
    const closeBtn = lightbox?.querySelector('[data-cert-lightbox-close]');
    const prevBtn = lightbox?.querySelector('[data-cert-lightbox-prev]');
    const nextBtn = lightbox?.querySelector('[data-cert-lightbox-next]');
    const triggers = Array.from(document.querySelectorAll<HTMLImageElement>('[data-lightbox-open][data-lightbox-index]'));
    if (!lightbox || !lightboxImg || triggers.length === 0) return;

    let current = 0;
    let startX = 0;

    function syncImage() {
      const source = triggers[current];
      if (!source || !lightboxImg) return;
      lightboxImg.src = source.src;
      lightboxImg.alt = source.alt;
    }

    function goTo(index: number) {
      current = (index + triggers.length) % triggers.length;
      syncImage();
    }

    function openLightbox(index: number) {
      if (!lightbox) return;
      current = index;
      if (lightbox.parentElement !== document.body) {
        document.body.appendChild(lightbox);
      }
      syncImage();
      lightbox.classList.add('active');
      lightbox.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.classList.remove('active');
      document.body.style.overflow = '';
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => openLightbox(i));
    });

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    lightbox.addEventListener('click', (e: Event) => {
      if (e.target === lightbox) closeLightbox();
    });

    lightbox.addEventListener('touchstart', (e: Event) => {
      startX = (e as TouchEvent).touches[0].clientX;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e: Event) => {
      const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? current + 1 : current - 1);
      }
    }, { passive: true });

    // Capture phase + stopPropagation so this always wins over any other
    // Escape handler on the page, regardless of script load order.
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') {
        closeLightbox();
        e.stopPropagation();
      }
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    }, true);
  }

  initCertsCarousel();
  initCertsLightbox();
  document.addEventListener('astro:after-swap', () => {
    initCertsCarousel();
    initCertsLightbox();
  });
</script>

<style>
  .certs-carousel {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .certs-list {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: var(--space-lg);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .certs-list::-webkit-scrollbar {
    display: none;
  }

  .certs-nav-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--backdrop-blur));
    -webkit-backdrop-filter: blur(var(--backdrop-blur));
    border: 1px solid var(--glass-border);
    color: var(--accent-color);
    font-size: var(--text-lg);
    cursor: pointer;
    box-shadow: var(--glow-shadow);
    transition: transform var(--transition-fast),
                box-shadow var(--transition-normal),
                opacity var(--transition-fast);
  }

  .certs-nav-btn:hover:not(:disabled),
  .certs-nav-btn:focus-visible:not(:disabled) {
    transform: scale(1.08);
    box-shadow: var(--glow-shadow-hover);
  }

  .certs-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 0 0 calc((100% - 2 * var(--space-lg)) / 3);
    scroll-snap-align: start;
  }

  .cert-image {
    width: 100%;
    height: 200px;
    border-radius: var(--radius-sm);
    background: #fff;
    padding: var(--space-sm);
  }

  .cert-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  .cert-name {
    font-size: var(--text-base);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cert-issuer {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    margin: 0;
  }

  .cert-verify {
    align-self: center;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .cert-card {
      flex-basis: calc((100% - var(--space-lg)) / 2);
    }
  }

  @media (max-width: 480px) {
    .cert-card {
      flex-basis: 100%;
    }

    .certs-nav-btn {
      width: 36px;
      height: 36px;
      font-size: var(--text-base);
    }
  }

  .cert-lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 1150;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl, 24px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
    outline: none;
  }

  .cert-lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .cert-lightbox-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    cursor: default;
  }

  .cert-lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    z-index: 2;
  }

  .cert-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .cert-lightbox-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    z-index: 2;
  }

  .cert-lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .cert-lightbox-btn.prev { left: 16px; }
  .cert-lightbox-btn.next { right: 16px; }

  @media (max-width: 600px) {
    .cert-lightbox-overlay {
      padding: 12px;
    }

    .cert-lightbox-close {
      top: 8px;
      right: 8px;
    }

    .cert-lightbox-btn.prev { left: 8px; }
    .cert-lightbox-btn.next { right: 8px; }
  }
</style>
