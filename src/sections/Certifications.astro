---
import certifications from '../data/certifications.json';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const certsTitle = strings['section.certifications.title'];
const verifyButton = strings['certifications.verifyButton'];
---

{certifications.length > 0 && (
  <section id="certificaciones" class="section">
    <h2 class="section-title">
      <span class="emoji-icon">&#128218;</span>
      <span data-i18n-es={certsTitle.es} data-i18n-en={certsTitle.en}>{certsTitle.es}</span>
    </h2>

    <div class="certs-list">
      {certifications.map((cert: any) => (
        <div class="card cert-card">
          <div class="cert-header">
            {cert.issuerLogo && (
              <a href={cert.issuerUrl} target="_blank" rel="noopener noreferrer">
                <img src={cert.issuerLogo} alt={`Logo ${cert.issuer}`} class="cert-logo" loading="lazy" />
              </a>
            )}
            <div class="cert-header-text">
              <h3 data-i18n-es={cert.name.es} data-i18n-en={cert.name.en}>{cert.name.es}</h3>
              <p class="cert-issuer">{cert.issuer} &middot; {cert.date}</p>
            </div>
          </div>

          {cert.description && (
            <p class="cert-description" data-i18n-es={cert.description.es} data-i18n-en={cert.description.en}>{cert.description.es}</p>
          )}

          {cert.topics && cert.topics.length > 0 && (
            <div class="cert-topics">
              {cert.topics.map((topic: { es: string; en: string }) => (
                <span class="cert-topic" data-i18n-es={topic.es} data-i18n-en={topic.en}>{topic.es}</span>
              ))}
            </div>
          )}

          {cert.verificationUrl && cert.verificationUrl !== "" && (
            <a href={cert.verificationUrl} target="_blank" rel="noopener noreferrer" class="btn-outline cert-verify">
              <i class="fas fa-external-link-alt"></i>
              <span data-i18n-es={verifyButton.es} data-i18n-en={verifyButton.en}>{verifyButton.es}</span>
            </a>
          )}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .certs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cert-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .cert-logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    background: #fff;
    padding: 4px;
  }

  .cert-header-text h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-xs);
  }

  .cert-issuer {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    margin: 0;
  }

  .cert-description {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.6;
    margin: 0;
  }

  .cert-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .cert-topic {
    background: var(--bg-color);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--secondary-text);
    border: 1px solid var(--border-color);
  }

  .cert-verify {
    align-self: flex-start;
  }
</style>
