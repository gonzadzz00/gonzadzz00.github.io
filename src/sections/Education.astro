---
import education from '../data/education.json';
import uiStrings from '../data/ui-strings.json';
import Illustration from '../components/Illustration.astro';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const educationTitle = strings['section.education.title'];
---

<section id="educacion" class="section">
  <h2 class="section-title reveal-title">
    <i class="fas fa-graduation-cap section-icon"></i>
    <span data-i18n-es={educationTitle.es} data-i18n-en={educationTitle.en}>{educationTitle.es}</span>
  </h2>

  <Illustration
    assetId="education"
    float
    class="education-art"
    alt={{ es: 'Ilustración de logro académico', en: 'Illustration of academic achievement' }}
  />

  <div class="timeline reveal-stagger" data-timeline>
    {education.map((entry: any) => (
      <div class="timeline-item">
      <div class="card education-card">
        <div class="edu-header">
          <a href={entry.institutionUrl} target="_blank" rel="noopener noreferrer">
            <img src={entry.institutionLogo} alt={`Logo ${entry.institution}`} class="edu-logo" loading="lazy" />
          </a>
          <h3>{entry.institution}</h3>
        </div>
        <h4 class="edu-program" data-i18n-es={entry.program.es} data-i18n-en={entry.program.en}>{entry.program.es}</h4>
        <p class="edu-description" data-i18n-es={entry.description.es} data-i18n-en={entry.description.en}>{entry.description.es}</p>
        <ul class="edu-competencies">
          {entry.competencies.map((comp: { es: string; en: string }) => (
            <li data-i18n-es={comp.es} data-i18n-en={comp.en}>{comp.es}</li>
          ))}
        </ul>
      </div>
      </div>
    ))}
  </div>
</section>

<style>
  .education-art {
    width: 220px;
    margin: 0 auto var(--space-xl);
  }

  /* Vertical timeline: the line draws itself when the list scrolls into view */
  .timeline {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding-left: var(--space-2xl);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-color), var(--accent-color-2));
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform var(--motion-duration-slow) var(--motion-ease);
  }

  .timeline.visible::before {
    transform: scaleY(1);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item + .timeline-item {
    margin-top: var(--space-xl);
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: calc(var(--space-2xl) * -1 + 3px);
    top: var(--space-xl);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--card-bg);
    border: 3px solid var(--accent-color);
    box-shadow: 0 0 0 4px rgba(0, 164, 239, 0.18);
  }

  @media (max-width: 480px) {
    .timeline {
      padding-left: var(--space-xl);
    }

    .timeline-item::before {
      left: calc(var(--space-xl) * -1 + 3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::before {
      transform: scaleY(1);
      transition: none;
    }
  }

  .education-card {
    display: flex;
    flex-direction: column;
  }

  /* Static cards: no hover lift, tilt or spotlight (the timeline carries the motion) */
  .card.education-card:hover,
  .card.education-card:focus-within {
    transform: none;
    box-shadow: var(--card-shadow), var(--glow-shadow);
  }

  .card.education-card::after {
    display: none;
  }

  .edu-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .edu-logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .edu-header h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .edu-program {
    color: var(--accent-color);
    font-size: var(--text-base);
    margin-bottom: var(--space-md);
  }

  .edu-description {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .edu-competencies {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .edu-competencies li {
    background: var(--bg-color);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--secondary-text);
    border: 1px solid var(--border-color);
  }
</style>
