---
import education from '../data/education.json';
import uiStrings from '../data/ui-strings.json';

const strings: Record<string, { es: string; en: string }> = uiStrings;
const educationTitle = strings['section.education.title'];
---

<section id="educacion" class="section">
  <h2 class="section-title">
    <span class="emoji-icon">&#127891;</span>
    <span data-i18n-es={educationTitle.es} data-i18n-en={educationTitle.en}>{educationTitle.es}</span>
  </h2>

  <div class="grid-2 reveal-stagger">
    {education.map((entry: any) => (
      <div class="card education-card">
        <div class="edu-header">
          <a href={entry.institutionUrl} target="_blank" rel="noopener noreferrer">
            <img src={entry.institutionLogo} alt={`Logo ${entry.institution}`} class="edu-logo" loading="lazy" />
          </a>
          <h3>{entry.institution}</h3>
        </div>
        <h4 class="edu-program" data-i18n-es={entry.program.es} data-i18n-en={entry.program.en}>{entry.program.es}</h4>
        <p class="edu-description" data-i18n-es={entry.description.es} data-i18n-en={entry.description.en}>{entry.description.es}</p>
        <ul class="edu-competencies">
          {entry.competencies.map((comp: { es: string; en: string }) => (
            <li data-i18n-es={comp.es} data-i18n-en={comp.en}>{comp.es}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .education-card {
    display: flex;
    flex-direction: column;
  }

  .edu-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .edu-logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .edu-header h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .edu-program {
    color: var(--accent-color);
    font-size: var(--text-base);
    margin-bottom: var(--space-md);
  }

  .edu-description {
    font-size: var(--text-sm);
    color: var(--secondary-text);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .edu-competencies {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .edu-competencies li {
    background: var(--bg-color);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--secondary-text);
    border: 1px solid var(--border-color);
  }
</style>
